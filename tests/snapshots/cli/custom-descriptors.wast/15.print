(module
  (rec
    (type $t (;0;) (descriptor $d) (struct))
    (type $d (;1;) (describes $t) (struct))
  )
  (type (;2;) (func (result (ref (exact $d)))))
  (func (;0;) (type 2) (result (ref (exact $d)))
    unreachable
    ref.get_desc $t
  )
  (func (;1;) (type 2) (result (ref (exact $d)))
    unreachable
    ref.as_non_null
    ref.get_desc $t
  )
  (func (;2;) (type 2) (result (ref (exact $d)))
    block ;; label = @1
      unreachable
      br_on_null 0 (;@1;)
      ref.get_desc $t
      return
    end
    unreachable
  )
)
