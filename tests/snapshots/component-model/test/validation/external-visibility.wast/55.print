(component
  (type $R (;0;) (resource (rep i32)))
  (instance $bag (;0;)
    (export "r" (type $R))
  )
  (instance $bag2 (;1;)
    (export "i" (instance $bag))
  )
  (export $bag2' (;2;) "i2" (instance $bag2))
  (alias export $bag2' "i" (instance $i (;3;)))
  (alias export $i "r" (type $R' (;1;)))
  (core func $drop (;0;) (canon resource.drop $R'))
  (type (;2;) (own $R'))
  (type (;3;) (func (param "x" 2)))
  (func $f (;0;) (type 3) (canon lift (core func $drop)))
  (export (;1;) "f" (func $f))
)
