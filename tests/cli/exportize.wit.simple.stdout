package exportize:exportize;

interface i {
  f: func();
}

interface a {
  x: func();
}

interface b {
  y: func();
}

world simple-rename {
  import f: func();
}
world with-deps {
  import a;
  import b;
}
world simple-toplevel {
  import bar: interface {
    baz: func();
  }
  import foo: func();
}
world selective {
  import a;
  import b;
}
world simple-exportized {
  export i;
}
