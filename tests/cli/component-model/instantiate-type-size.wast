;; RUN: wast --assert default --snapshot tests/snapshots %

;; Instantiating a component copies and remaps the types of its exports to
;; create the type of the new instance, so the size of the exports is charged
;; against a budget for all instantiations. `$d` below has no imports but
;; exports a component with a large type.
(assert_invalid
  (component $c
    (type $i0 (instance (export "a" (func)) (export "b" (func))))
    (type $i1 (instance (export "a" (instance (type $i0))) (export "b" (instance (type $i0)))))
    (type $i2 (instance (export "a" (instance (type $i1))) (export "b" (instance (type $i1)))))
    (type $i3 (instance (export "a" (instance (type $i2))) (export "b" (instance (type $i2)))))
    (type $i4 (instance (export "a" (instance (type $i3))) (export "b" (instance (type $i3)))))
    (type $i5 (instance (export "a" (instance (type $i4))) (export "b" (instance (type $i4)))))
    (type $i6 (instance (export "a" (instance (type $i5))) (export "b" (instance (type $i5)))))
    (type $i7 (instance (export "a" (instance (type $i6))) (export "b" (instance (type $i6)))))
    (type $i8 (instance (export "a" (instance (type $i7))) (export "b" (instance (type $i7)))))
    (type $i9 (instance (export "a" (instance (type $i8))) (export "b" (instance (type $i8)))))
    (type $i10 (instance (export "a" (instance (type $i9))) (export "b" (instance (type $i9)))))
    (type $i11 (instance (export "a" (instance (type $i10))) (export "b" (instance (type $i10)))))
    (type $i12 (instance (export "a" (instance (type $i11))) (export "b" (instance (type $i11)))))
    (type $i13 (instance (export "a" (instance (type $i12))) (export "b" (instance (type $i12)))))
    (type $i14 (instance (export "a" (instance (type $i13))) (export "b" (instance (type $i13)))))
    (type $i15 (instance (export "a" (instance (type $i14))) (export "b" (instance (type $i14)))))
    (type $i16 (instance (export "a" (instance (type $i15))) (export "b" (instance (type $i15)))))
    (component $d
      (alias outer $c $i16 (type $t))
      (component $e (import "x" (instance (type $t))))
      (export "e" (component $e)))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
    (instance (instantiate $d))
  )
  "effective type size exceeds the limit")

;; The budget is shared with nested components, so instantiations can't be
;; split up across many nested components to avoid the limit.
(assert_invalid
  (component $c
    (type $i0 (instance (export "a" (func)) (export "b" (func))))
    (type $i1 (instance (export "a" (instance (type $i0))) (export "b" (instance (type $i0)))))
