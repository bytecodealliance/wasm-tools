// RUN: component wit --merge-world-imports-based-on-semver foo %

package test:pkg;

world foo {
  import a:b/c@0.1.0;
  import a:b/c@0.1.1;
  import my-thing: a:b/c@0.1.0;
  import my-thing-2: a:b/c@0.1.2;
  export my-export: a:b/c@0.1.1;
  export my-export-2: a:b/c@0.1.0;
}

package a:b@0.1.0 {
  interface c {
    f: func();
  }
}

package a:b@0.1.1 {
  interface c {
    f: func();
    g: func();
  }
}

package a:b@0.1.2 {
  interface c {
    f: func();
    g: func();
    h: func();
  }
}
