// RUN[default]: component embed % --dummy -w foo | component new | print
// RUN[merge]: component embed % --dummy -w foo | component new --merge-imports-based-on-semver=true | print
// RUN[no-merge]: component embed % --dummy -w foo | component new --merge-imports-based-on-semver=false | print

// The two imports are semver-compatible, so merging collapses them onto
// `@0.1.1` and leaving them alone keeps `@0.1.0` around. `default` and `merge`
// therefore have to agree, and `no-merge` has to differ from both.

package a:b;

world foo {
  import a:b/c@0.1.0;
  import a:b/c@0.1.1;
}

package a:b@0.1.0 {
  interface c {
    f: func();
  }
}

package a:b@0.1.1 {
  interface c {
    f: func();
  }
}
