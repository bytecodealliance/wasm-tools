(module
  (type $thread-start-func-ty (func (param i64)))

  ;; Async imports
  (import "$root" "[async-lower]foo" (func (param i64 i64 i64) (result i32)))
  (import "foo:foo/bar" "[async-lower]foo" (func (param i64 i64 i64) (result i32)))
  (import "foo:foo/streams" "[async-lower]foo" (func (param i32 i32 i64) (result i32)))

  ;; Async builtins
  (import "$root" "[backpressure-inc]" (func))
  (import "$root" "[backpressure-dec]" (func))
  (import "[export]$root" "[task-cancel]" (func))
  (import "[export]$root" "[task-return]foo" (func (param i64 i64)))
  (import "[export]foo:foo/bar" "[task-return]foo" (func (param i64 i64)))
  (import "[export]foo:foo/exp" "[task-return][method]a.name" (func (param i64 i64)))
  (import "$root" "[waitable-set-new]" (func (result i32)))
  (import "$root" "[waitable-set-wait]" (func (param i32 i64) (result i32)))
  (import "$root" "[waitable-set-poll]" (func (param i32 i64) (result i32)))
  (import "$root" "[waitable-set-drop]" (func (param i32)))
  (import "$root" "[waitable-join]" (func (param i32 i32)))
  (import "$root" "[thread-yield]" (func (result i32)))
  (import "$root" "[subtask-drop]" (func (param i32)))
  (import "$root" "[subtask-cancel]" (func (param i32) (result i32)))
  (import "$root" "[error-context-new-utf8]" (func (param i64 i64) (result i32)))
  (import "$root" "[error-context-new-utf16]" (func (param i64 i64) (result i32)))
  (import "$root" "[error-context-new-latin1+utf16]" (func (param i64 i64) (result i32)))
  (import "$root" "[error-context-debug-message-utf8]" (func (param i32 i64)))
  (import "$root" "[error-context-debug-message-utf16]" (func (param i32 i64)))
  (import "$root" "[error-context-debug-message-latin1+utf16]" (func (param i32 i64)))
  (import "$root" "[error-context-drop]" (func (param i32)))

  ;; Context slots may be `i64`, and the closure passed to
  ;; `thread.new-indirect` is pointer-sized.
  (import "$root" "[context-get-0]" (func (result i64)))
  (import "$root" "[context-set-0]" (func (param i64)))
  (import "$root" "[context-get-1]" (func (result i64)))
  (import "$root" "[context-set-1]" (func (param i64)))
  (import "$root" "[thread-index]" (func (result i32)))
  (import "$root" "[thread-new-indirect-v0]" (func (param i64 i64) (result i32)))
  (import "$root" "[thread-resume-later]" (func (param i32)))
  (import "$root" "[thread-suspend]" (func (result i32)))
  (import "$root" "[thread-suspend-then-resume]" (func (param i32) (result i32)))
  (import "$root" "[thread-yield-then-resume]" (func (param i32) (result i32)))
  (import "$root" "[thread-suspend-then-promote]" (func (param i32) (result i32)))
  (import "$root" "[thread-yield-then-promote]" (func (param i32) (result i32)))

  ;; Resource intrinsics for an exported resource with an async method
  (import "[export]foo:foo/exp" "[resource-new]a" (func (param i64) (result i32)))
  (import "[export]foo:foo/exp" "[resource-rep]a" (func (param i32) (result i64)))

  ;; Stream and future intrinsics, for both imports and exports
  (func (import "foo:foo/streams" "[stream-new-2]foo") (result i64))
  (func (import "foo:foo/streams" "[stream-read-2]foo") (param i32 i64 i64) (result i64))
  (func (import "foo:foo/streams" "[stream-write-2]foo") (param i32 i64 i64) (result i64))
  (func (import "foo:foo/streams" "[stream-cancel-read-2]foo") (param i32) (result i32))
  (func (import "foo:foo/streams" "[stream-cancel-write-2]foo") (param i32) (result i32))
  (func (import "foo:foo/streams" "[stream-drop-readable-2]foo") (param i32))
  (func (import "foo:foo/streams" "[stream-drop-writable-2]foo") (param i32))
  (func (import "foo:foo/streams" "[future-new-0]foo") (result i64))
  (func (import "foo:foo/streams" "[future-read-0]foo") (param i32 i64) (result i32))
  (func (import "foo:foo/streams" "[future-write-0]foo") (param i32 i64) (result i32))
  (func (import "foo:foo/streams" "[future-cancel-read-0]foo") (param i32) (result i32))
  (func (import "foo:foo/streams" "[future-cancel-write-0]foo") (param i32) (result i32))
  (func (import "foo:foo/streams" "[future-drop-readable-0]foo") (param i32))
  (func (import "foo:foo/streams" "[future-drop-writable-0]foo") (param i32))
  (func (import "foo:foo/streams" "[future-new-1]foo") (result i64))
  (func (import "foo:foo/streams" "[future-read-1]foo") (param i32 i64) (result i32))
  (func (import "foo:foo/streams" "[future-write-1]foo") (param i32 i64) (result i32))
  (func (import "foo:foo/streams" "[future-cancel-read-1]foo") (param i32) (result i32))
  (func (import "foo:foo/streams" "[future-cancel-write-1]foo") (param i32) (result i32))
  (func (import "foo:foo/streams" "[future-drop-readable-1]foo") (param i32))
  (func (import "foo:foo/streams" "[future-drop-writable-1]foo") (param i32))
  (func (import "[export]foo:foo/streams" "[stream-new-2]foo") (result i64))
  (func (import "[export]foo:foo/streams" "[stream-read-2]foo") (param i32 i64 i64) (result i64))
  (func (import "[export]foo:foo/streams" "[stream-write-2]foo") (param i32 i64 i64) (result i64))
  (func (import "[export]foo:foo/streams" "[stream-cancel-read-2]foo") (param i32) (result i32))
  (func (import "[export]foo:foo/streams" "[stream-cancel-write-2]foo") (param i32) (result i32))
  (func (import "[export]foo:foo/streams" "[stream-drop-readable-2]foo") (param i32))
  (func (import "[export]foo:foo/streams" "[stream-drop-writable-2]foo") (param i32))
  (func (import "[export]foo:foo/streams" "[future-new-0]foo") (result i64))
  (func (import "[export]foo:foo/streams" "[future-read-0]foo") (param i32 i64) (result i32))
  (func (import "[export]foo:foo/streams" "[future-write-0]foo") (param i32 i64) (result i32))
  (func (import "[export]foo:foo/streams" "[future-cancel-read-0]foo") (param i32) (result i32))
  (func (import "[export]foo:foo/streams" "[future-cancel-write-0]foo") (param i32) (result i32))
  (func (import "[export]foo:foo/streams" "[future-drop-readable-0]foo") (param i32))
  (func (import "[export]foo:foo/streams" "[future-drop-writable-0]foo") (param i32))
  (func (import "[export]foo:foo/streams" "[future-new-1]foo") (result i64))
  (func (import "[export]foo:foo/streams" "[future-read-1]foo") (param i32 i64) (result i32))
  (func (import "[export]foo:foo/streams" "[future-write-1]foo") (param i32 i64) (result i32))
  (func (import "[export]foo:foo/streams" "[future-cancel-read-1]foo") (param i32) (result i32))
  (func (import "[export]foo:foo/streams" "[future-cancel-write-1]foo") (param i32) (result i32))
  (func (import "[export]foo:foo/streams" "[future-drop-readable-1]foo") (param i32))
  (func (import "[export]foo:foo/streams" "[future-drop-writable-1]foo") (param i32))

  ;; Exports lifted with a callback ...
  (func (export "[async-lift]foo:foo/bar#foo") (param i64 i64) (result i32) unreachable)
  (func (export "[callback][async-lift]foo:foo/bar#foo") (param i32 i32 i32) (result i32) unreachable)
  (func (export "foo:foo/exp#[constructor]a") (result i32) unreachable)
  (func (export "[async-lift]foo:foo/exp#[method]a.name") (param i64 i64) (result i32) unreachable)
  (func (export "[callback][async-lift]foo:foo/exp#[method]a.name") (param i32 i32 i32) (result i32) unreachable)
  (func (export "foo:foo/exp#[dtor]a") (param i64))

  ;; ... and stackful exports
  (func (export "[async-lift-stackful]foo") (param i64 i64) unreachable)
  (func (export "[async-lift-stackful]foo:foo/streams#foo") (param i32 i32) unreachable)

  (func $thread_main (export "thread_main") (type $thread-start-func-ty) unreachable)
  (table (export "__indirect_function_table") i64 1 1 funcref)
  (elem (table 0) (i64.const 0) func $thread_main)

  (memory (export "memory") i64 1)
  (func (export "cabi_realloc") (param i64 i64 i64 i64) (result i64) unreachable)
)
